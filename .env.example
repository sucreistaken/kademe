# Database. Local: docker compose up -d. Production: Neon, Frankfurt region.
DATABASE_URL=postgresql://kademe:kademe@localhost:5434/kademe

# Session and token hashing pepper, and the key that signs local playback
# URLs. Generate with: openssl rand -hex 32
# Required in production. Development falls back to a fixed string.
AUTH_SECRET=

# Cloudflare R2, EU jurisdiction. Never make this bucket public.
# All four of ACCESS_KEY_ID, SECRET_ACCESS_KEY, BUCKET and ENDPOINT are needed;
# with any of them missing the app writes to local disk instead.
# In production (NODE_ENV=production) that fallback is refused and the process
# fails at the first storage call, because recordings on the container disk
# are lost on the next deploy. See docs/STORAGE.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kademe-media
R2_ENDPOINT=

# Storage safety switches. Leave both unset in normal use.
# STORAGE_ALLOW_LOCAL=true is the explicit opt in that lets a production
# process store recordings on its own disk (a single VM with a persistent
# volume, for example). It also requires AUTH_SECRET. Every start logs a
# warning while it is set.
STORAGE_ALLOW_LOCAL=
# STORAGE_REQUIRE_R2=1 makes development and CI refuse the disk fallback the
# way production already does. Useful for a staging environment.
STORAGE_REQUIRE_R2=

# AI. Only three purposes: template drafting, transcription, summarising the
# manager's own evaluation. Never scoring or ranking a candidate.
# Without a key the AI builder refuses out loud: no suggestions, and never an
# invented draft that a manager could not tell apart from a real one.
#
# Three providers. Leave AI_PROVIDER unset and the first configured one wins,
# in the order gemini, nvidia, openrouter. Gemini leads on latency, not price:
# a draft on the NVIDIA reasoning model took 131 to 275 seconds, which does not
# fit in a server action. OpenRouter, the one that bills per call, stays last.
# Naming a provider that has no key refuses rather than falling back, so the job
# ad never travels to a subprocessor nobody named.
AI_PROVIDER=

# Google AI Studio. Defaults to gemini-3.6-flash, which honours responseSchema
# and answers in seconds rather than minutes. The draft schema is rewritten for
# it in toGeminiSchema: this API takes an OpenAPI 3.0 subset, not JSON Schema.
# When this one runs out of retries and NVIDIA_API_KEY is set, the call is
# retried once on NVIDIA and the screen says the wait grew.
GOOGLE_AI_API_KEY=
GEMINI_MODEL=

# NVIDIA. Defaults to nvidia/nemotron-3-ultra-550b-a55b, which honours the JSON
# schema and writes usable Turkish. Do NOT use nemotron-3-super-120b-a12b: it
# narrates its reasoning into the answer even with a schema attached. It is a
# reasoning model, so a draft takes minutes rather than seconds.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# OpenRouter. Defaults to anthropic/claude-sonnet-5, which supports provider
# enforced structured output and writes Turkish a manager can read without
# editing. Costs roughly two cents per draft, so the account needs credit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Transcription. Without the key the pipeline refuses to run rather than
# inventing text: no ELEVENLABS_API_KEY means no transcript rows are written.
ELEVENLABS_API_KEY=
# Batch speech to text model. Defaults to scribe_v2.
ELEVENLABS_STT_MODEL=
# Published rate used to estimate ai_runs.cost_usd from media duration.
ELEVENLABS_STT_USD_PER_HOUR=0.22

# Shared secret for /api/cron/* endpoints
CRON_SECRET=
